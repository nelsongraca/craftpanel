{
  "name": "craftpanel-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "prebuild": "node scripts/generate-icons.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "node scripts/format-changed.mjs --write",
