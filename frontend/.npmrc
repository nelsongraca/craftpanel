ignore-build-scripts=false
node-linker=hoisted
# Do NOT set store-dir here. Pinning it inside the repo forces the pnpm store into
# frontend/ and requires the cache path in .github/workflows/{ci,system}.yml to be kept
# in lockstep with it. Let pnpm use its default ($PNPM_HOME/store, else
# ~/.local/share/pnpm/store).
